{
  "name": "dsh-purge-pj",
  "version": "1.1.98",
  "description": "DeepSeek Harness 破甲：让所有模型都能破甲，不同模型可换不同提示词；默认提示词面向国模「小码酱」。Jailbreak for every model — swap prompts per model. 求 Star 收藏 ⭐ 如要二开，请查看署名要求部分",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./client.js",
    "./redteam": "./lib/redteam/index.js",
    "./redteam/store": "./lib/redteam/store.js",
    "./redteam/ui": "./lib/redteam/ui.js",
    "./redteam/tools": "./lib/redteam/tools.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-purge-pj": "bin/dsh-purge.js"
  },
  "files": [
    "lib",
    "!lib/default-prompt-inject.md",
    "bin",
    "docs",
    "presets",
    "skills",
    "scripts",
    "client.js",
    "cordis.patch.yml",
    "screenshots.json",
    "README.md",
    "README.en.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "embed-prompt": "node scripts/embed-default-prompt.mjs",
    "skills:sha": "node scripts/skills-sha.mjs --verify",
    "qoder:sync": "node scripts/sync-qoder-prompt.mjs",
    "qoder:check": "node scripts/sync-qoder-prompt.mjs --check",
    "qoder:verify": "node lib/qoder/qoder-purge.mjs --verify",
    "build:client": "node scripts/build-client.mjs",
    "postinstall": "node scripts/ensure-profile-bundle.mjs",
    "test": "node --test",
    "test:update-rollback": "node scripts/official-update-rollback.mjs",
    "contract": "node scripts/gen-patch-contract.mjs",
    "contract:check": "node scripts/gen-patch-contract.mjs --check"
  },
  "license": "Apache-2.0",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-plugins",
    "网络安全",
    "红队评测",
    "llm-security",
    "harness-security",
    "deepseek-harness",
    "red-team",
    "instructions",
    "rules",
    "prompt-eval",
    "agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fzhenhong/dsh-purge-pj.git"
  },
  "homepage": "https://github.com/Fzhenhong/dsh-purge-pj#readme",
  "bugs": {
    "url": "https://github.com/Fzhenhong/dsh-purge-pj/issues"
  },
  "dshPurgeFork": {
    "of": "YuJunZhiXue/dsh-purge",
    "repo": "Hrh97/dsh-purge-merged",
    "edition": "merged",
    "note": "整合版：代码基线是上游，另吸收了 JeffKeeping / evilevil / luowang-ui / dsh-purge-flash 的能力。见 docs/UPSTREAM.md"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    },
    "install": {
      "preferred": "tarball",
      "tarball": "https://codeload.github.com/Fzhenhong/dsh-purge-pj/tar.gz/refs/heads/master",
      "zip": "https://codeload.github.com/Fzhenhong/dsh-purge-pj/zip/refs/heads/master",
      "git": "https://github.com/Fzhenhong/dsh-purge-pj.git"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "engines": {
    "node": ">=18"
  },
  "dshTarget": "0.2.1-rc.2",
  "dshTargets": [
    "0.2.1-rc.2",
    "0.2.1-rc.5"
  ]
}
